# =============================================================================
#  FAST — {{DOMAIN}}
#  Gerado por deploy/scripts/nginx.sh. Não edite manualmente:
#  altere o template e rode `sudo make nginx`.
# =============================================================================

# Zona de rate limit compartilhada (o início de auditorias é o custo real).
limit_req_zone $binary_remote_addr zone=fast_audit:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=fast_general:10m rate=120r/m;

upstream fast_backend {
    server 127.0.0.1:{{PORT}};
    keepalive 32;
}

# ---- HTTP -------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    # Desafio do Let's Encrypt precisa ficar sempre acessível em HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    {{HTTPS_REDIRECT}}

    # {{HTTP_ONLY}} location / {
    # {{HTTP_ONLY}}     proxy_pass http://fast_backend;
    # {{HTTP_ONLY}}     proxy_http_version 1.1;
    # {{HTTP_ONLY}}     proxy_set_header Host $host;
    # {{HTTP_ONLY}}     proxy_set_header X-Real-IP $remote_addr;
    # {{HTTP_ONLY}}     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # {{HTTP_ONLY}}     proxy_set_header X-Forwarded-Proto $scheme;
    # {{HTTP_ONLY}}     proxy_buffering off;
    # {{HTTP_ONLY}}     proxy_read_timeout 300s;
    # {{HTTP_ONLY}} }
}

# >>> SSL-BEGIN
# ---- HTTPS ------------------------------------------------------------------
server {
    listen 443 ssl{{HTTP2_LISTEN}};
    listen [::]:443 ssl{{HTTP2_LISTEN}};
    {{HTTP2_DIRECTIVE}}
    server_name {{DOMAIN}};

    # ---- TLS ----
    ssl_certificate     /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{DOMAIN}}/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # ---- Cabeçalhos de segurança ----
    # A própria plataforma audita esses cabeçalhos; aqui servimos de exemplo.
    # O include precisa ser repetido em todo location que tenha add_header
    # próprio — ver o comentário no topo do snippet.
    include /etc/nginx/snippets/fast-security-headers.conf;

    server_tokens off;
    client_max_body_size 1m;

    # ---- Compressão ----
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml+rss application/atom+xml image/svg+xml
               application/manifest+json;

    # Brotli quando o módulo estiver disponível (ngx_brotli).
    # brotli on;
    # brotli_comp_level 5;
    # brotli_types text/plain text/css application/json application/javascript image/svg+xml;

    root {{APP_DIR}}/frontend/dist;
    index index.html;

    # ---- Desafio ACME ----
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # ---- Auditoria em streaming (SSE) ----
    # Buffering DESLIGADO: cada evento precisa chegar ao navegador na hora.
    location /api/audit/stream {
        limit_req zone=fast_audit burst=5 nodelay;

        proxy_pass http://fast_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_cache off;
        gzip off;
        chunked_transfer_encoding off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # ---- Demais rotas de API ----
    location /api/ {
        limit_req zone=fast_general burst=30 nodelay;

        proxy_pass http://fast_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- Assets versionados pelo Vite ----
    location /assets/ {
        # O add_header abaixo cancela a herança; reincluímos os de segurança.
        include /etc/nginx/snippets/fast-security-headers.conf;
        # Sem `expires` aqui: ele emitiria um segundo Cache-Control, duplicando
        # o max-age na resposta. O add_header abaixo já cobre tudo.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ---- SPA ----
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        # Idem: o add_header abaixo cancelaria os cabeçalhos de segurança.
        include /etc/nginx/snippets/fast-security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }
}
# <<< SSL-END
