[Unit]
Description=FAST — Plataforma de auditoria web (performance, SEO, GEO e IA)
Documentation=https://github.com/openflexi/fast
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fast
Group=fast
WorkingDirectory={{APP_DIR}}

EnvironmentFile={{APP_DIR}}/.env
Environment=NODE_ENV=production
Environment=PLAYWRIGHT_BROWSERS_PATH={{BROWSERS_PATH}}

# O heap do Node fica limitado: o relatório inteiro passa por memória, e sem
# teto o processo cresce até disputar RAM com o Chromium.
ExecStart=/usr/bin/node --max-old-space-size={{NODE_HEAP_MB}} {{APP_DIR}}/backend/dist/server.js

Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# ---- Memória ----
# O Chromium headless é o consumidor real. Em máquina pequena (t3.micro, 1 GB)
# o teto precisa ser MENOR que a RAM da máquina: assim o cgroup mata só este
# serviço — que o Restart=always traz de volta em segundos — em vez de deixar o
# kernel sem memória e o servidor inteiro travado, sem SSH.
#   MemoryHigh: a partir daqui o kernel pressiona o serviço (swap, cache)
#   MemoryMax:  limite absoluto; passar disso é OOM só deste serviço
MemoryHigh={{MEMORY_HIGH}}
MemoryMax={{MEMORY_MAX}}
MemoryAccounting=true
OOMPolicy=continue
# Prioridade menor que a do sistema: sob pressão, o SSH continua respondendo.
Nice=5
TasksMax=512
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fast

# ---- Endurecimento ----
# O Chromium precisa de namespaces próprios; por isso NoNewPrivileges e
# PrivateUsers ficam desligados — o sandbox do navegador depende deles.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={{APP_DIR}} /tmp /var/lib/fast
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
