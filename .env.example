# ---------------------------------------------------------------------------
# FAST — configuração
# Copie para .env e ajuste. O `make install` cria o .env automaticamente.
# ---------------------------------------------------------------------------

# Domínio público da aplicação (usado pelo nginx e pelo certbot)
FAST_DOMAIN=fast.openflexi.com

# E-mail para registro/renovação do certificado Let's Encrypt
FAST_SSL_EMAIL=admin@openflexi.com

# Porta interna do backend Fastify (o nginx faz proxy para ela)
PORT=3001
HOST=127.0.0.1

# Ambiente
NODE_ENV=production

# Origens permitidas para CORS (separadas por vírgula). Vazio = mesma origem.
CORS_ORIGIN=https://fast.openflexi.com

# Atrás de um CDN/proxy (CloudFront, etc.)? Defina como 1 — ou rode `sudo make cdn`,
# que grava isso automaticamente. A origem passa a servir por HTTP sem redirecionar
# para HTTPS (o CDN termina o TLS), evitando o loop ERR_TOO_MANY_REDIRECTS.
# Deixe vazio/0 em deploy direto (sem CDN), para forçar HTTPS na própria origem.
FAST_BEHIND_CDN=

# ID da distribuição do CloudFront. Se definido (e o aws CLI estiver instalado e
# autenticado), `sudo make cdn` invalida o cache (/*) automaticamente ao final.
FAST_CLOUDFRONT_ID=

# ---------------------------------------------------------------------------
# Módulo 10 — Inteligência Artificial (via Ollama self-hosted)
# Sem FAST_AI_URL o módulo é desativado e a auditoria técnica roda normalmente.
# Os dados não saem da sua infraestrutura.
# ---------------------------------------------------------------------------
FAST_AI_URL=http://redis.flexi.ltd:11434/api/generate
FAST_AI_MODEL=qwen3.6:27b
# Token bearer do Ollama (o Flexi usa "ollama").
FAST_AI_TOKEN=ollama
# Tempo máximo de espera pela resposta do modelo (ms). Modelos grandes são lentos.
FAST_AI_TIMEOUT=120000
FAST_AI_TEMPERATURE=0.3
# Janela de contexto e limite de tokens da resposta (JSON longo não pode truncar).
FAST_AI_NUM_CTX=8192
FAST_AI_NUM_PREDICT=3072
FAST_AI_KEEP_ALIVE=24h

# ---------------------------------------------------------------------------
# Limites de execução
# ---------------------------------------------------------------------------
# Tempo máximo da COLETA da página (ms)
FAST_AUDIT_TIMEOUT=120000
# Teto da auditoria inteira — coleta + módulos + IA (ms). Ao estourar, a
# auditoria é cancelada de verdade: as abas do Chromium são fechadas e a vaga
# volta para a fila.
FAST_AUDIT_HARD_TIMEOUT=180000
# Visitantes que podem esperar na fila. Acima disso a resposta é "tente em
# alguns minutos" — melhor do que uma espera que ninguém aguarda.
FAST_MAX_QUEUE=20
# Tempo máximo de navegação por página (ms)
FAST_NAV_TIMEOUT=45000
# Auditorias simultâneas. Cada uma sobe uma instância do Chromium: em máquina
# de 1 GB (t3.micro) mantenha 1 — as demais esperam na fila, o que é bem melhor
# do que o servidor travar. Suba para 2 ou 3 apenas com 4 GB ou mais.
FAST_MAX_CONCURRENCY=1
# Requisições por minuto por IP nas rotas leves de API. Arquivos estáticos
# (index.html, assets, llms.txt, robots.txt) NÃO entram nesta conta.
FAST_RATE_LIMIT=60
# Auditorias iniciadas por minuto por IP — o limite que protege a máquina.
FAST_AUDIT_RATE_LIMIT=12

# ---------------------------------------------------------------------------
# Memória — ciclo de vida do Chromium
# ---------------------------------------------------------------------------
# O Chromium não devolve memória sozinho: ele cresce a cada página analisada.
# Estes dois limites o mantêm sob controle sem pagar o custo de subir o
# navegador a cada auditoria.
#
# Fecha o navegador após este tempo sem uso (ms). 0 desliga.
FAST_BROWSER_IDLE_MS=90000
# Recicla o navegador a cada N auditorias. 0 desliga.
FAST_BROWSER_MAX_USES=8
# Modo de baixa memória (menos processos, heap do renderer limitado).
# Vazio = detecta pela RAM da máquina; 1 força ligado; 0 força desligado.
FAST_LOW_MEMORY=
